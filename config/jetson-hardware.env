# Jetson MF9025V2 hardware mapping.
# Prefer stable /dev/serial/by-path names so USB enumeration order cannot swap axes.
THERAPY_ROBOT_G0_PORT=/dev/serial/by-path/platform-3610000.xhci-usb-0:2.1:1.0-port0
THERAPY_ROBOT_G1_PORT=/dev/serial/by-path/platform-3610000.xhci-usb-0:2.2:1.0-port0
THERAPY_ROBOT_G2_PORT=/dev/serial/by-path/platform-3610000.xhci-usb-0:2.3:1.0-port0

# Existing project mapping: G0=K0, G1=K1/K2, G2=K3/K4.
THERAPY_ROBOT_G0_MOTOR_IDS=1
THERAPY_ROBOT_G1_MOTOR_IDS=1,2
THERAPY_ROBOT_G2_MOTOR_IDS=1,2
THERAPY_ROBOT_ACTIVE_GROUPS=all

# Change a direction only after a mechanically unloaded single-axis test.
# Physical test on 2026-07-24 confirmed that direction +1 made a negative K0
# command raise the arm.  Use -1 so positive K0 means upward after the stowed
# pose is captured as zero.  K1-K4 directions remain pending final validation.
THERAPY_ROBOT_AXIS_DIRECTIONS=-1,-1,1,1,1

# Per-axis feedback tolerance outside the command soft limits.  Native units
# differ by reducer ratio, so one global native margin is unsafe.  These values
# correspond to K0 1 mm and K1-K4 0.25 degree.
THERAPY_ROBOT_AXIS_LIMIT_MARGIN_NATIVE=21600,1200,300,250,250

# Fixed multi-turn absolute positions captured at the physical stowed pose on
# 2026-07-26. Never replace these with the startup pose: doing so would make
# Cartesian coordinates depend on where the arm happened to be at power-on.
THERAPY_ROBOT_AXIS_OFFSETS_NATIVE=58504,-5464,217372,4164,2365
THERAPY_ROBOT_AUTO_ZERO_ON_START=0
THERAPY_ROBOT_AXIS_OFFSETS_FILE=/home/jetsonorin/Documents/therapy_robot/config/axis-offsets-native.txt
# K0's controller drops whole-turn accumulation after motor-off. Because K0
# has a normally-engaged brake and cannot be moved by hand, preserve its last
# brake-protected logical height and rebuild the 0x92 session offset at start.
THERAPY_ROBOT_K0_POSITION_FILE=/home/jetsonorin/Documents/therapy_robot/config/k0-last-logical-native.txt
THERAPY_ROBOT_REQUIRE_K0_POSITION_FILE=1

# Every accepted position command records start/target/actual native values,
# converted mm/deg, signed rotor turns and accumulated travel. The same JSONL
# event is appended to a second file so one accidental edit does not erase it.
THERAPY_ROBOT_MOTION_LOG_FILE=/home/jetsonorin/Documents/therapy_robot/data/motor-motion-history.jsonl
THERAPY_ROBOT_MOTION_LOG_BACKUP_FILE=/home/jetsonorin/Documents/therapy_robot/data/backup/motor-motion-history.backup.jsonl

# MG/MF speed uses motor-rotor 0.01 degree/second units. Commissioning speed
# raised on 2026-07-26 after K0 +20 mm motion was physically verified:
# K0 72000 -> 5 mm/s through i8, 72:72 and a 20 mm lead screw.
# K1 14400 -> 3 deg/s through i36 and 60:80 pulleys. Keep this conservative
# because the long upper arm becomes unstable at higher speed.
# K2 9600 -> 8 deg/s through i9 and 60:80 pulleys.
# K3/K4 8000 -> 8 deg/s through the direct i10 actuators.
THERAPY_ROBOT_MAX_SPEED_NATIVE=5000
THERAPY_ROBOT_AXIS_MAX_SPEED_NATIVE=72000,14400,9600,8000,8000

# Nano original behavior: only K0 has a normally-engaged brake. 0x8C state
# 0 means engaged and state 1 means released. Verify the physical brake before
# the first K0 motion test; remove K0 here if the installed actuator has none.
THERAPY_ROBOT_BRAKE_AXES=K0
THERAPY_ROBOT_BRAKE_COMMAND_RETRIES=3
THERAPY_ROBOT_BRAKE_RETRY_GAP_MS=50

THERAPY_ROBOT_MOTOR_POLL_MS=50
THERAPY_ROBOT_SERIAL_TIMEOUT_MS=200
THERAPY_ROBOT_WATCHDOG_MS=1000
THERAPY_ROBOT_MAX_COMM_FAILURES=3
THERAPY_ROBOT_REQUIRE_ALL_PORTS=1

# Set a verified current conversion and positive limit to enable over-current
# shutdown. Zero disables current-threshold shutdown until calibration exists.
THERAPY_ROBOT_CURRENT_SCALE_A=0.01
THERAPY_ROBOT_MAX_CURRENT_A=0

# Volatile RAM zero is blocked by default and ROM zero is never exposed.
# Enables persistent software-only capture of the current stowed pose. This
# does not write the reducer/electrical zero into the motor controller.
THERAPY_ROBOT_ALLOW_ZERO=1
THERAPY_ROBOT_CLEAR_ERRORS_ON_ENABLE=0
THERAPY_ROBOT_ALLOW_OUTSIDE_LIMITS=0

# K2 0x92/0x94 jumped by +324324 native when emergency-stop powered the
# drive off on 2026-08-09. Motion history proved the physical joint stopped
# at -78596 logical native (-65.497 deg); this corrected offset preserves that
# physical angle instead of treating the coordinate-branch jump as motion.

# Fixed-enclosure collision boundary. The checked-in file is deliberately
# disabled until enclosure, slot and link-envelope dimensions are measured.
# After physical calibration set enabled=true in that file and change REQUIRED
# to 1 so hardware startup fails closed if the boundary cannot be loaded.
THERAPY_ROBOT_COLLISION_CONFIG=/home/jetsonorin/Documents/therapy_robot/config/enclosure-collision.csv
THERAPY_ROBOT_COLLISION_REQUIRED=1
